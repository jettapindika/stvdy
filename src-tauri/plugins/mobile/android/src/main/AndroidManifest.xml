<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The mobile plugin's manifest (A311, A313, A318).

      Permissions are declared here and asked for at runtime where the platform
      requires it (`POST_NOTIFICATIONS` from API 33, via the plugin's
      `mobile_request_notification_permission`).

      `SCHEDULE_EXACT_ALARM` is declared (A318) and the design assumes it is **not
      granted**: it is user-revocable from API 31, so a reminder that must be exact is
      a reminder that is wrong on a phone that denies it. Nothing here depends on it —
      the notification plugin falls back to inexact `setAndAllowWhileIdle` — and it is
      declared only so a future exact path does not have to add a permission to a
      shipped manifest.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application>
        <!--
          The FCM receive service. The official `tauri-plugin-notification` registers
          no `com.google.firebase.MESSAGING_EVENT` service at all, which is why push
          receive is the pinned `tauri-plugin-notifications` crate instead (A310);
          this service is the silent-push path into the Rust seam.
        -->
        <service
            android:name="app.stvdy.mobile.StvdyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
