{
  "$schema": "../app/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stvdy",
  "version": "0.1.0",
  "identifier": "app.stvdy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stvdy",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:8080 https://api.stvdy.app; frame-ancestors 'none'; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/**", "$APPLOCALDATA/**"],
          "deny": ["$APPLOCALDATA/secret/**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": { "installMode": "perMachine" }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["stvdy"] },
      "mobile": [{ "scheme": "stvdy" }]
    }
  }
}
