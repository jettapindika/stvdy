name: stvdy-shell
options:
  bundleIdPrefix: app.stvdy
  deploymentTarget:
    iOS: 15.0
fileGroups: [../../src]
configs:
  debug: debug
  release: release
settingGroups:
  app:
    base:
      PRODUCT_NAME: Stvdy
      PRODUCT_BUNDLE_IDENTIFIER: app.stvdy
targetTemplates:
  app:
    type: application
    sources:
      - path: Sources
    scheme:
      environmentVariables:
        RUST_BACKTRACE: full
        RUST_LOG: info
    settings:
      groups: [app]
targets:
  stvdy-shell_iOS:
    type: application
    platform: iOS
    sources:
      - path: Sources
      - path: Assets.xcassets
      # Exclude built static libs: regenerating with xcodegen after a build
      # otherwise turns the per-configuration libapp.a copies into colliding
      # resources ("Multiple commands produce …/libapp.a"). They are linked
      # via LIBRARY_SEARCH_PATHS, never bundled as resources.
      - path: Externals
        excludes: ["**/*.a"]
      - path: stvdy-shell_iOS
      - path: assets
        buildPhase: resources
        type: folder
      - path: LaunchScreen.storyboard
    info:
      path: stvdy-shell_iOS/Info.plist
      properties:
        LSRequiresIPhoneOS: true
        UILaunchStoryboardName: LaunchScreen
        UIRequiredDeviceCapabilities: [arm64, metal]
        UISupportedInterfaceOrientations:
          - UIInterfaceOrientationPortrait
          - UIInterfaceOrientationLandscapeLeft
          - UIInterfaceOrientationLandscapeRight
        UISupportedInterfaceOrientations~ipad:
          - UIInterfaceOrientationPortrait
          - UIInterfaceOrientationPortraitUpsideDown
          - UIInterfaceOrientationLandscapeLeft
          - UIInterfaceOrientationLandscapeRight
        CFBundleShortVersionString: 0.1.3
        CFBundleVersion: "0.1.0"
    entitlements:
      path: stvdy-shell_iOS/stvdy-shell_iOS.entitlements
      # Generated by XcodeGen from these properties, not hand-edited: a file at
      # `path` alone is overwritten with `<dict/>` on every `xcodegen generate`
      # (measured), so an entitlement written by hand into it does not survive.
      properties:
        # The App Group the Share Extension writes into (A312). One string; the
        # extension's own entitlements carry the same one.
        com.apple.security.application-groups:
          - group.app.stvdy
    scheme:
      environmentVariables:
        RUST_BACKTRACE: full
        RUST_LOG: info
    settings:
      base:
        ENABLE_BITCODE: false
        ARCHS: [arm64]
        VALID_ARCHS: arm64 
        LIBRARY_SEARCH_PATHS[arch=x86_64]: $(inherited) $(PROJECT_DIR)/Externals/x86_64/$(CONFIGURATION) $(SDKROOT)/usr/lib/swift $(DEVELOPER_DIR)/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/$(PLATFORM_NAME) $(DEVELOPER_DIR)/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift-5.0/$(PLATFORM_NAME)
        LIBRARY_SEARCH_PATHS[arrm64]: $(inherited) $(PROJECT_DIR)/Externals/arm64/$(CONFIGURATION) $(SDKROOT)/usr/lib/swift $(DEVELOPER_DIR)/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/$(PLATFORM_NAME) $(DEVELOPER_DIR)/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift-5.0/$(PLATFORM_NAME)
        ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES: true
        EXCLUDED_ARCHS[sdk=iphoneos*]: x86_64
      groups: [app]
    dependencies:
      - framework: libapp.a
        embed: false
      - sdk: CoreGraphics.framework
      - sdk: Metal.framework
      - sdk: MetalKit.framework
      - sdk: QuartzCore.framework
      - sdk: Security.framework
      - sdk: UIKit.framework
      - sdk: WebKit.framework
      # The Share Extension is a second product in the same bundle (A312). Tauri has
      # no `bundle` key for an app-extension target, which is why it is hand-wired
      # here; `embed: true` is what puts it in `Embed App Extensions` so the OS can
      # launch it from the share sheet.
      - target: ShareExtension
        embed: true
    preBuildScripts:
      - script: |
          node ../../../app/node_modules/@tauri-apps/cli/tauri.js ios xcode-script -v --platform "${PLATFORM_DISPLAY_NAME:?}" --sdk-root "${SDKROOT:?}" --framework-search-paths "${FRAMEWORK_SEARCH_PATHS:?}" --header-search-paths "${HEADER_SEARCH_PATHS:?}" --gcc-preprocessor-definitions "${GCC_PREPROCESSOR_DEFINITIONS:-}" --configuration "${CONFIGURATION:?}" ${FORCE_COLOR} ${ARCHS:?}
        name: Build Rust Code
        basedOnDependencyAnalysis: false
        outputFiles:
          - $(SRCROOT)/Externals/x86_64/${CONFIGURATION}/libapp.a
          - $(SRCROOT)/Externals/arm64/${CONFIGURATION}/libapp.a
  # The iOS Share Extension (A312). An app-extension *target*, not a plugin: Tauri's
  # plugin layer cannot express one, and an extension point is a bundle-level concept.
  #
  # It links UIKit and Foundation only — no Tauri, no `libapp.a`, no webview. A share
  # can arrive with the app suspended, so there is no engine to call; and starting one
  # from an extension is not something iOS permits.
  ShareExtension:
    type: app-extension
    platform: iOS
    sources:
      - path: ShareExtension
        # XcodeGen writes these two from the blocks below; leaving them in `sources`
        # as well would put a generated file in a Resources phase.
        excludes:
          - "Info.plist"
          - "*.entitlements"
    info:
      path: ShareExtension/Info.plist
      properties:
        CFBundleDisplayName: Stvdy
        # The App Store validator rejects an extension whose version does not match its
        # host, and this file is the only place the extension's comes from — the CLI's
        # `bundle.iOS.bundleVersion` merge reaches the app's plist only. So these two
        # mirror `tauri.conf.json`'s `version` and `bundle.iOS.bundleVersion`, and
        # `tests/share_group.rs` asserts they still do rather than trusting a comment.
        CFBundleShortVersionString: 0.1.3
        CFBundleVersion: "1"
        NSExtension:
          NSExtensionPointIdentifier: com.apple.share-services
          NSExtensionPrincipalClass: $(PRODUCT_MODULE_NAME).ShareViewController
          # A dictionary, not the `TRUEPREDICATE` string: the extension is offered for
          # the file types the app can actually hold (A313), and `TRUEPREDICATE` would
          # put Stvdy in the share sheet for every item on the device.
          NSExtensionAttributes:
            NSExtensionActivationRule:
              NSExtensionActivationSupportsFileWithMaxCount: 4
              NSExtensionActivationSupportsImageWithMaxCount: 4
              NSExtensionActivationSupportsWebURLWithMaxCount: 1
    entitlements:
      path: ShareExtension/ShareExtension.entitlements
      properties:
        # The same App Group the app declares. A different string here is the silent
        # failure this whole design has to avoid: two containers, both empty.
        com.apple.security.application-groups:
          - group.app.stvdy
    settings:
      base:
        PRODUCT_NAME: ShareExtension
        PRODUCT_BUNDLE_IDENTIFIER: app.stvdy.ShareExtension
        SWIFT_VERSION: 5.0
        TARGETED_DEVICE_FAMILY: "1,2"
        SKIP_INSTALL: YES