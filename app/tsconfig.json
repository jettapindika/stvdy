{
  "compilerOptions": {
    "target": "ES2023",
    // `ES2024.Promise` is here for `Promise.withResolvers`, which a test uses to hold a
    // request open (`StudyScreen.test.tsx`'s in-flight state). Nothing in `src/` outside
    // a test uses it: it is Safari 17.4 / Chrome 119, and the shipped bundle's own floor
    // is whatever the Tauri webview provides — a narrower lib entry rather than bumping
    // `target`, so the ES2023 surface the app is written against stays the default.
    "lib": ["ES2023", "ES2024.Promise", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    // TypeScript 7 defaults `types` to [] and enables
    // noUncheckedSideEffectImports, so vite/client must be listed explicitly or
    // `import './styles.css'` is a hard type error.
    "types": ["vite/client", "node", "vitest/globals"],
    // TypeScript 7 removed `baseUrl`; paths resolve relative to this file.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
