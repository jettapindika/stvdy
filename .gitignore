# Rust
/target
**/target

# Node / frontend
/app/node_modules
/app/dist
# The store build (`VITE_PLATFORM=mobile`), which is the bundle the iOS and
# Android shells load and the artifact `check-no-purchase-ui.mjs` inspects.
/app/dist-mobile
# The staging build's own output directory. Added when a third slice started
# writing it: every other Vite output here is ignored with its reason, so leaving
# this one tracked meant a `git add -A` could commit a whole bundle.
/app/dist-local
/app/coverage
# Vitest's own cache, written when a reporter flag is passed (`--reporter=json`
# creates `app/.vitest/json/output.json`). The rule above covers only the
# `node_modules/.vite/vitest` directory the default invocation uses.
/app/.vitest
# Vitest resolves its cache directory against the *current* directory, and the
# documented invocation (`npm --prefix app test`, `justfile`) runs from the repo
# root, so it creates `/node_modules/.vite/vitest` here. Untracked cache, ignored
# so the tree stays clean after the gate runs.
/node_modules

# Native shell: `gen` is deliberately NOT ignored. Tauri's CLI writes its own
# .gitignore containing `*` inside gen/<project>/.tauri/, which implies the
# surrounding generated project tree is meant to be tracked — and it is where
# the Phase 14 native work lives (iOS Share Extension target, Info.plist
# BGTaskSchedulerPermittedIdentifiers + UIBackgroundModes, App Group
# entitlements). Ignoring it would silently drop hand-written native files.

# Mobile signing and service credentials (A328). `google-services.json` is the
# Android Google Services plugin's project credential; a committed one is a leaked
# key. `src-tauri/google-services.json.example` documents the shape and is tracked.
# The two Apple files are a distribution certificate's private key and the
# provisioning profile it pairs with — an entitlement without a signing identity
# fails at the point where it is hardest to diagnose, and a `.p12` in the tree is a
# private key in the tree.
google-services.json
**/*.p12
**/*.mobileprovision

# Local env and scratch. `.env*` plus an explicit un-ignore, so a real
# `.env.prod` cannot be committed by `git add -A` while the template stays
# tracked.
.env*
!.env.example
!.env.supabase.example
var/
.fastembed_cache/

# Supabase CLI link state (project ref, cached API versions): machine-local.
supabase/.temp/

# macOS
.DS_Store

# Vite preview / build scratch
/app/.vite

# Python bytecode: `stub-llm.py` and `stub-qris.py` are run directly by the smoke
# scripts, so a cache directory appears the first time either is imported rather
# than run. It is machine-local and never shipped.
__pycache__/
*.pyc
