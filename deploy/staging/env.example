# The staging server's environment, deployed as `<deployment root>/.env.staging` and read by
# `docker-compose.yml`'s `server` service through `env_file`. **Not** compose's own `.env`,
# which carries only what the compose file interpolates (`POSTGRES_PASSWORD`, `SERVER_IMAGE`).
#
# Placeholders only: the real file is written on the host and never committed.
#
# The values below are the ones a staging deploy needs, and the absences are the point — see
# `docs/OPERATIONS.md` § Staging for why each one is empty.

# --- core ---
APP_ENV=prod
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info
DATABASE_URL=postgres://stvdy:<POSTGRES_PASSWORD>@postgres:5432/stvdy
JWT_SECRET=<openssl rand -hex 32>
ENCRYPTION_KEY_HEX=<openssl rand -hex 32>

# --- origins ---
# The SPA's origin, which is what the browser's CORS preflight is checked against. It must
# equal the origin the SPA is served from, and the bundle's `VITE_API_BASE_URL` must be that
# same origin — with `/api` on it, because nginx serves the API under that path on one origin
# (`deploy/staging/nginx.conf`).
WEB_ORIGIN=https://stvdy.ztvn.my.id
# The presigned read URL is built as `{this}/objects/{id}`, so it carries the same `/api`
# prefix and comes back through nginx.
OBJECTS_PUBLIC_BASE_URL=https://stvdy.ztvn.my.id/api

# --- storage ---
# Local rather than S3: R2 is the production backend (A331) and staging is not worth a bucket.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/data/objects

# --- mail ---
# Empty on purpose: the dev file sink writes each message under `MAIL_DIR`, which is the only
# way to read a verification link on a host with no inbox (B3).
SMTP_URL=
MAIL_DIR=/data/mail
MAIL_FROM=stvdy-staging@example.test

# --- the image's own paths (docs/OPERATIONS.md § The server image) ---
CHROME_PATH=/usr/bin/chromium
PDFIUM_LIB_PATH=/opt/pdfium/lib/libpdfium.so
SOFFICE_BIN=/usr/bin/soffice
FASTEMBED_CACHE_DIR=/opt/models/fastembed
ASSETS_DIR=/opt/assets
# Empty means `http://127.0.0.1:<BIND_ADDR port>`, which is where the renderer's own Chromium
# reaches the server (A339).
ASSETS_BASE_URL=

# --- search ---
# A344: SearXNG is a separate service. On this host it is the compose service in the
# repository's own `docker-compose.yml`, on the same project network, with no published port.
SEARXNG_URL=http://searxng:8080/
SEARXNG_SECRET=<openssl rand -hex 32>
SEARCH_PROVIDER=composite

# --- providers ---
PLANS_CONFIG=config/plans.toml
BILLING_POLICY_CONFIG=config/billing_policy.toml
ADMIN_EMAIL=<your address>
LLM_BASE_URL=<provider>
LLM_API_KEY=<key>
LLM_MODEL=<model>
EMBEDDER=fastembed
EMBEDDER_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

# --- the payment gateway (B1, resolved) ---
#
# The gopay-bridge sidecar runs in this compose project and is reached by service name on
# `stvdy_default`. It publishes **no host port**, so nothing about it is an address a third
# party has been told about — which is what makes it admissible on this host, unlike the
# QRIS *webhook* URL A45 forbids here: the bridge never pushes, so there is no public
# callback endpoint at all.
#
# It authenticates to GoPay with its own phone-OTP session, kept in
# `~/stvdy/data/gopay/gopay-session.json` (0600, uid 65532) and refreshed by the bridge
# itself. The server holds no gateway credential, which is why there is no `QRIS_API_KEY`
# here. See `docs/OPERATIONS.md` § Payments.
QRIS_BASE_URL=http://gopay-bridge:8787
# The merchant whose transaction feed the reconciliation sweep reads. Required: the sweep is the
# only thing that notices money the gateway took with no row behind it (A301).
QRIS_MERCHANT_ID=<your merchant id, from `GET http://gopay-bridge:8787/me`>
# An empty `QRIS_BASE_URL` is a supported deployment: checkout answers 502 and every other
# route is unaffected. Everything below has a working default.

# --- deliberately absent (A45: nothing a third party was told about may live on this host) ---
# The Google OAuth redirect URI and the updater manifests are addresses a third party has
# been told about, and this host is a one-month trial.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
