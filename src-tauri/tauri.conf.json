{
  "$schema": "../app/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stvdy",
  "version": "0.1.2",
  "identifier": "app.stvdy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stvdy",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:8080 https://api.stvdy.app; frame-ancestors 'none'; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/**", "$APPLOCALDATA/**"],
          "deny": ["$APPLOCALDATA/secret/**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "iOS": {
      "minimumSystemVersion": "15.0",
      "bundleVersion": "1",
      "infoPlist": "gen/apple/Info.ios.plist",
      "template": "gen/apple/project.yml.template"
    },
    "android": { "minSdkVersion": 24, "versionCode": 1 },
    "fileAssociations": [
      { "ext": ["pdf"], "mimeType": "application/pdf", "name": "PDF" },
      { "ext": ["epub"], "mimeType": "application/epub+zip", "name": "EPUB" },
      {
        "ext": ["docx"],
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "name": "DOCX"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "bundleVersion": "1",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": { "installMode": "perMachine" },
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["stvdy"] },
      "mobile": [
        { "scheme": ["stvdy"] },
        { "host": "app.stvdy", "scheme": ["https"], "appLink": true }
      ]
    },
    "notifications": {},
    "updater": {
      "endpoints": ["https://updates.stvdy.app/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "<the operator's minisign public key>",
      "windows": { "installMode": "passive" }
    }
  }
}
